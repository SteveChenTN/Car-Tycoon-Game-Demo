{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "游戏事件模板 - 随机事件和历史事件",
  "version": "1.0.0",
  
  "events": [
    {
      "id": "oil_crisis_1973",
      "event_type": "ECONOMIC",
      "severity": "HIGH",
      "title": "石油危机",
      "description": "中东石油禁运导致油价暴涨，消费者偏好转向小排量省油车型。",
      "trigger_conditions": {
        "min_turn": 1,
        "year_range": [1973, 1974]
      },
      "trigger_probability": 1.0,
      "effects": {
        "fuel_price_multiplier": 3.0,
        "small_car_demand_bonus": 40,
        "large_car_demand_penalty": -30,
        "duration_turns": 12
      },
      "min_year": 1973,
      "max_year": 1974
    },
    {
      "id": "tech_breakthrough_turbo",
      "event_type": "TECHNOLOGY",
      "severity": "INFO",
      "title": "涡轮技术突破",
