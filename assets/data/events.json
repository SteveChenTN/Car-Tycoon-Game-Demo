      "trigger_conditions": {
        "min_turn": 10,
        "tech_level_min": 4
      },
      "trigger_probability": 0.15,
      "effects": {
        "turbo_research_cost_reduction": 20,
        "turbo_reliability_bonus": 5
      },
      "min_year": null,
      "max_year": null
    },
